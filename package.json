{
	"name": "@codeeditorland/vscode",
	"displayName": "Tauri",
	"version": "0.0.1",
	"private": false,
	"description": "Enhances the experience of Tauri apps development",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/TauriLand#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/TauriLand/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/TauriLand.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "./dist/extension.js",
	"scripts": {
		"compile": "tsup src/extension.ts --clean --format cjs --external vscode",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"contributes": {
		"commands": [
			{
				"category": "Tauri",
				"command": "tauri.init",
				"title": "Init"
			},
			{
				"category": "Tauri",
				"command": "tauri.dev",
				"title": "Dev"
			},
			{
				"category": "Tauri",
				"command": "tauri.build",
				"title": "Build"
			},
			{
				"category": "Tauri",
				"command": "tauri.build-debug",
				"title": "Build with debug"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": [
					"tauri.conf.json",
					"tauri.conf.json5",
					"tauri.*.conf.json",
					"tauri.*.conf.json5"
				],
				"url": "tauri://schemas/config.json"
			}
		],
		"snippets": [
			{
				"language": "rust",
				"path": "./snippets/rust.json"
			}
		]
	},
	"activationEvents": [
		"workspaceContains:**/tauri.conf.json",
		"workspaceContains:**/tauri.*.conf.json",
		"workspaceContains:**/tauri.conf.json5",
		"workspaceContains:**/tauri.*.conf.json5",
		"onFileSystem:tauri"
	],
	"dependencies": {},
	"devDependencies": {
		"@playform/build": "0.2.2",
		"@types/node": "22.14.0",
		"axios": "1.8.4",
		"glob": "11.0.1",
		"run-in-terminal": "0.0.3",
		"strip-ansi": "7.1.0",
		"tsup": "8.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"icon": "assets/icon.png"
}
